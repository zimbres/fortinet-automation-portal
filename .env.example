# Example only. Django does not automatically load this file.
DJANGO_SETTINGS_MODULE=config.settings.development
# Production: mount a secret and configure DJANGO_SECRET_KEY_FILE.
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
# DJANGO_ALLOWED_HOSTS=portal.example.internal
# PORTAL_DATA_DIR=/app/data
# PORTAL_ENCRYPTION_KEYS_FILE=/run/secrets/encryption_keys
# PORTAL_AUTH_MODE=oidc
# OIDC_OP_ISSUER=https://identity.example.internal/realms/portal
# OIDC_RP_CLIENT_ID=fortinet-portal
# OIDC_RP_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_OP_AUTHORIZATION_ENDPOINT=https://identity.example.internal/realms/portal/protocol/openid-connect/auth
# OIDC_OP_TOKEN_ENDPOINT=https://identity.example.internal/realms/portal/protocol/openid-connect/token
# OIDC_OP_USER_ENDPOINT=https://identity.example.internal/realms/portal/protocol/openid-connect/userinfo
# OIDC_OP_JWKS_ENDPOINT=https://identity.example.internal/realms/portal/protocol/openid-connect/certs
